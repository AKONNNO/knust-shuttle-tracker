# Copy this file to `.env` to override defaults. All values are optional —
# the app ships with working fallbacks for the connected KNUST Supabase project.

# Supabase project URL (browser-safe).
# VITE_SUPABASE_URL=https://gzmwitfkfsxhnsqocgvs.supabase.co

# Supabase publishable/anon key (browser-safe).
# VITE_SUPABASE_ANON_KEY=sb_publishable_zYBXnTve7SrTsd0S8D37HA_bhHJmzsw

# Optional MapLibre style URL to replace the bundled campus snap-style
# (e.g. your own tiles/vector style hosted anywhere).
# Leave unset to use the built-in campus map.
# VITE_MAP_STYLE_URL=https://example.com/style.json
