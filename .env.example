# ============================================================
# KNUST Shuttle Tracker — environment variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.
# ============================================================

# --- Supabase (client-side, safe to expose: they are publishable keys) ---
# Project URL + publishable/anon key from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# --- Supabase (server-side ONLY — NEVER expose to the client) ---
# Service role key from: Supabase Dashboard -> Project Settings -> API
# Used by the Nitro server routes (/api/admin/...) for privileged actions.
NITRO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NITRO_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Map tiles / style (optional overrides) ---
# By default the app loads the bundled Snap-Map style (public/map-style.json)
# which uses keyless OpenFreeMap vector tiles (3D buildings included).
# Point this at any MapLibre-compatible style JSON URL to use your own or
# a paid provider (MapTiler, Mapbox, WeGoMaps, ...).
VITE_MAP_STYLE_URL=

# --- Directions / road snapping (server-side) ---
# Defaults to OSRM public demo server (fine for dev/test).
# Override with a production routing endpoint when available.
# The routing call re-snaps admin routes to real roads (Uber/inDrive style).
NITRO_ROUTING_URL=https://router.project-osrm.org/route/v1

# --- WeGoMaps (optional, if you use their tiles/directions) ---
NITRO_WECOMAPS_API_KEY=wmk_xxxxxxxxxxxxxxxxxxxxxxxx
